#!/usr/bin/env python3
"""Release the keyboard shortcuts GNOME grabs, so they reach a VM instead.

GNOME claims dozens of Super combinations at the X server before the browser
ever sees the keypress, and they are exactly the ones a tiling WM wants:
Super+1..9 for workspaces, Super+Space for the menu, Super+Left/Right for focus.
Super+L is the nastiest -- Omarchy toggles the workspace layout with it, GNOME
locks the *host*.

Super is not the whole story. Omarchy also binds Alt+Tab (focus next window),
Ctrl+Alt+Delete (close all windows) and Print (screenshot), and GNOME grabs all
three -- Ctrl+Alt+Delete opens its logout dialog.

Locking the host stays available: Super+L is GNOME's only lock binding and
Omarchy wants that chord, so release moves host lock to Ctrl+Alt+L instead of
dropping it.

  gnome-key-grabs release   # hand the shortcuts to the VM
  gnome-key-grabs restore   # give them back to GNOME
  gnome-key-grabs status

Only the Super entries are stripped; other accelerators bound to the same action
are left alone, so e.g. move-to-workspace-left keeps its Ctrl+Shift+Alt+Left.
Every original value is saved verbatim and restored verbatim.
"""

import ast
import json
import os
import subprocess
import sys

STATE = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "domarchy", "gnome-key-grabs.json",
)

# Non-Super accelerators that Omarchy binds and GNOME also grabs. Kept as an
# explicit list rather than a pattern: releasing a shortcut the guest has no use
# for would cost host function for nothing.
EXTRA = {
    "<Alt>Tab",             # Omarchy: focus next window
    "<Shift><Alt>Tab",      # Omarchy: focus previous window
    "<Control><Alt>Tab",    # Omarchy: focus next monitor
    "<Control><Alt>Delete", # Omarchy: close all windows / GNOME: log out
    "Print",                # Omarchy: screenshot
    "<Alt>Print",           # Omarchy: screen recording
}


# Shortcuts to hand back on a different key rather than simply drop. Super+L is
# GNOME's only lock binding, and Omarchy wants that chord for its workspace
# layout toggle, so locking the host would otherwise be unreachable from the
# keyboard for as long as the grabs are released. Ctrl+Alt+L is the traditional
# lock chord and Omarchy binds nothing to it.
REPLACEMENTS = {
    ("org.gnome.settings-daemon.plugins.media-keys", "screensaver"): "['<Control><Alt>l']",
}


def normalize(accel):
    """GNOME writes Control three ways; compare them as one."""
    return accel.replace("<Primary>", "<Control>").replace("<Ctrl>", "<Control>")


def conflicts(accel):
    # Not every gsettings array holds accelerator strings; some hold tuples.
    if not isinstance(accel, str):
        return False
    return "Super" in accel or normalize(accel) in EXTRA


def sh(*args):
    return subprocess.run(args, capture_output=True, text=True)


def wanted(raw):
    """Does this raw gsettings value hold a shortcut we need to free?"""
    if raw.startswith("["):
        try:
            return any(conflicts(a) for a in ast.literal_eval(raw))
        except (ValueError, SyntaxError):
            return False
    # Plain strings here are overlay-key and mouse-button-modifier, where only
    # Super is ever in the way.
    return "'Super_L'" in raw or "'Super_R'" in raw or "<Super>" in raw


def scan():
    """Every schema/key whose current value holds a shortcut we want freed."""
    found = []
    schemas = sh("gsettings", "list-schemas").stdout.split()
    for schema in sorted(set(schemas)):
        listed = sh("gsettings", "list-recursively", schema)
        if listed.returncode != 0:
            continue
        for line in listed.stdout.splitlines():
            parts = line.split(" ", 2)
            if len(parts) != 3:
                continue
            s, key, raw = parts
            if s == schema and wanted(raw):
                found.append((schema, key, raw))
    return found


def stripped(raw):
    """The value with Super accelerators removed, or None to leave alone."""
    if raw.startswith("["):
        try:
            parsed = ast.literal_eval(raw)
        except (ValueError, SyntaxError):
            return None
        if not all(isinstance(a, str) for a in parsed):
            return None
        keep = [a for a in parsed if not conflicts(a)]
        return "[" + ", ".join(repr(a) for a in keep) + "]"
    if raw.startswith("'"):
        return "''"
    return None


def release():
    if os.path.exists(STATE):
        sys.exit(f"Already released (backup at {STATE}). Run 'restore' first.")
    entries = scan()
    if not entries:
        sys.exit("No grabbed shortcuts found -- nothing to release.")

    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as fh:
        json.dump([{"schema": s, "key": k, "value": v} for s, k, v in entries], fh, indent=2)

    changed = failed = swapped = 0
    for schema, key, raw in entries:
        new = REPLACEMENTS.get((schema, key)) or stripped(raw)
        if new is None or new == raw:
            continue
        if (schema, key) in REPLACEMENTS:
            swapped += 1
        if sh("gsettings", "set", schema, key, new).returncode == 0:
            changed += 1
        else:
            failed += 1
            print(f"  could not set {schema} {key}", file=sys.stderr)

    print(f"Released {changed} binding(s); {len(entries)} saved to {STATE}")
    if failed:
        print(f"{failed} failed -- see above.", file=sys.stderr)
    if swapped:
        print("Lock the host with Ctrl+Alt+L while released (Super+L now goes to the VM).")
    print("Those shortcuts now reach the VM. Undo with: gnome-key-grabs restore")


def restore():
    if not os.path.exists(STATE):
        sys.exit("Nothing to restore -- no backup found.")
    with open(STATE) as fh:
        saved = json.load(fh)

    restored = failed = 0
    for item in saved:
        # The saved text is verbatim `gsettings get` output, which is valid
        # GVariant, so it round-trips through `set` unchanged.
        if sh("gsettings", "set", item["schema"], item["key"], item["value"]).returncode == 0:
            restored += 1
        else:
            failed += 1
            print(f"  could not restore {item['schema']} {item['key']}", file=sys.stderr)

    if failed:
        print(f"{failed} binding(s) failed; keeping backup at {STATE}", file=sys.stderr)
        sys.exit(1)
    os.remove(STATE)
    print(f"Restored {restored} binding(s). GNOME has its shortcuts back.")


def status():
    live = scan()
    if os.path.exists(STATE):
        with open(STATE) as fh:
            print(f"RELEASED -- {len(json.load(fh))} binding(s) backed up at {STATE}")
    else:
        print("NORMAL -- GNOME holds its usual shortcuts")
    print(f"{len(live)} grabbed binding(s) currently active")
    for schema, key, raw in live:
        print(f"  {schema} {key} = {raw}")


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "release":
        release()
    elif action == "restore":
        restore()
    elif action == "status":
        status()
    else:
        sys.exit(__doc__)
